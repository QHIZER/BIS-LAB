    "\n",
    "import numpy as np\n",
    "\n",
    "# ---------------------------------\n",
    "# 1. INPUT PARAMETERS\n",
    "# ---------------------------------\n",
    "\n",
    "jobs = [4, 2, 6, 3, 5, 2]  # Processing times\n",
    "num_jobs = len(jobs)\n",
    "num_machines = 3\n",
    "\n",
    "num_wolves = 10\n",
    "max_iterations = 100\n",
    "\n",
    "np.random.seed(42)\n",
    "\n",
    "\n",
    "# ---------------------------------\n",
    "# 2. CONVERT WOLF POSITION TO SCHEDULE\n",
    "# ---------------------------------\n",
    "\n",
    "def decode(position):\n",
    "    schedule = [[] for _ in range(num_machines)]\n",
    "\n",
    "    for i in range(num_jobs):\n",
    "        machine = min(int(position[i]), num_machines - 1)\n",
    "        schedule[machine].append(i)\n",
    "\n",
    "    return schedule\n",
    "\n",
    "\n",
    "# ---------------------------------\n",
    "# 3. FITNESS FUNCTION\n",
    "# ---------------------------------\n",
    "\n",
    "def fitness(position):\n",
    "    schedule = decode(position)\n",
    "\n",
    "    machine_times = []\n",
    "\n",
    "    for machine_jobs in schedule:\n",
    "        total = sum(jobs[j] for j in machine_jobs)\n",
    "        machine_times.append(total)\n",
    "\n",
    "    # Minimize maximum completion time\n",
    "    return max(machine_times)\n",
    "\n",
    "\n",
    "# ---------------------------------\n",
    "# 4. INITIALIZE WOLF POPULATION\n",
    "# ---------------------------------\n",
    "\n",
    "wolves = np.random.uniform(\n",
    "    0, num_machines, (num_wolves, num_jobs)\n",
    ")\n",
    "\n",
    "best_fitness_history = []\n",
    "\n",
    "\n",
    "# ---------------------------------\n",
    "# 5. GREY WOLF OPTIMIZATION\n",
    "# ---------------------------------\n",
    "\n",
    "for iteration in range(max_iterations):\n",
    "\n",
    "    # Evaluate fitness\n",
    "    scores = np.array([fitness(w) for w in wolves])\n",
    "\n",
    "    # Identify Alpha, Beta and Delta\n",
    "    sorted_indices = np.argsort(scores)\n",
    "\n",
    "    alpha = wolves[sorted_indices[0]].copy()\n",
    "    beta = wolves[sorted_indices[1]].copy()\n",
    "    delta = wolves[sorted_indices[2]].copy()\n",
    "\n",
    "    alpha_score = scores[sorted_indices[0]]\n",
    "\n",
    "    best_fitness_history.append(alpha_score)\n",
    "\n",
    "    # Decrease a from 2 to 0\n",
    "    a = 2 - (2 * iteration / max_iterations)\n",
    "\n",
    "    # Update each wolf\n",
    "    new_wolves = []\n",
    "\n",
    "    for wolf in wolves:\n",
    "\n",
    "        # Alpha calculation\n",
    "        r1 = np.random.rand(num_jobs)\n",
    "        r2 = np.random.rand(num_jobs)\n",
    "\n",
    "        A1 = 2 * a * r1 - a\n",
    "        C1 = 2 * r2\n",
    "\n",
    "        D_alpha = abs(C1 * alpha - wolf)\n",
    "        X1 = alpha - A1 * D_alpha\n",
    "\n",
    "        # Beta calculation\n",
    "        r1 = np.random.rand(num_jobs)\n",
    "        r2 = np.random.rand(num_jobs)\n",
    "\n",
    "        A2 = 2 * a * r1 - a\n",
    "        C2 = 2 * r2\n",
    "\n",
    "        D_beta = abs(C2 * beta - wolf)\n",
    "        X2 = beta - A2 * D_beta\n",
    "\n",
    "        # Delta calculation\n",
    "        r1 = np.random.rand(num_jobs)\n",
    "        r2 = np.random.rand(num_jobs)\n",
    "\n",
    "        A3 = 2 * a * r1 - a\n",
    "        C3 = 2 * r2\n",
    "\n",
    "        D_delta = abs(C3 * delta - wolf)\n",
    "        X3 = delta - A3 * D_delta\n",
    "\n",
    "        # Update wolf position\n",
    "        new_position = (X1 + X2 + X3) / 3\n",
    "\n",
    "        # Keep positions within valid boundaries\n",
    "        new_position = np.clip(\n",
    "            new_position, 0, num_machines - 1e-9\n",
    "        )\n",
    "\n",
    "        new_wolves.append(new_position)\n",
    "\n",
    "    wolves = np.array(new_wolves)\n",
    "\n",
    "\n",
    "# ---------------------------------\n",
    "# 6. FIND BEST SCHEDULE\n",
    "# ---------------------------------\n",
    "\n",
    "scores = np.array([fitness(w) for w in wolves])\n",
    "best_index = np.argmin(scores)\n",
    "\n",
    "best_wolf = wolves[best_index]\n",
    "best_schedule = decode(best_wolf)\n",
    "best_makespan = fitness(best_wolf)\n",
    "\n",
    "\n",
    "# ---------------------------------\n",
    "# 7. DISPLAY RESULTS\n",
    "# ---------------------------------\n",
    "\n",
    "print(\"\\n----- GWO JOB SCHEDULING RESULTS -----\")\n",
    "\n",
    "for i, machine_jobs in enumerate(best_schedule):\n",
    "\n",
    "    print(f\"\\nMachine {i + 1}:\")\n",
    "\n",
    "    if machine_jobs:\n",
    "        for job in machine_jobs:\n",
    "            print(f\"Job J{job + 1} - {jobs[job]} hours\")\n",
    "    else:\n",
    "        print(\"No jobs assigned\")\n",
    "\n",
    "    total_time = sum(jobs[j] for j in machine_jobs)\n",
    "\n",
    "    print(\"Total processing time:\", total_time, \"hours\")\n",
    "\n",
    "print(\"\\nBest Makespan:\", best_makespan, \"hours\")\n",
    "\n",
    "\n",
    "# ---------------------------------\n",
    "# 8. DISPLAY CONVERGENCE\n",
    "# ---------------------------------\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.plot(best_fitness_history)\n",
    "\n",
    "plt.xlabel(\"Iterations\")\n",
    "plt.ylabel(\"Makespan\")\n",
    "plt.title(\"GWO Job Scheduling Optimization\")\n",
    "\n",
    "plt.grid(True)\n",
    "plt.show()\n"
   ]
